{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "portfolio",
	"keep_vars": false,
	"send_metrics": false,
	"compatibility_date": "2026-01-22",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"workers_dev": false,
	"preview_urls": true,
	"route": {
		"pattern": "elfin.fr",
		"custom_domain": true
	}
}